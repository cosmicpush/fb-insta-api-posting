# Meta Graph API credentials
INSTAGRAM_USER_ID=replace-with-instagram-user-id
FACEBOOK_PAGE_ID=replace-with-facebook-page-id
META_ACCESS_TOKEN=replace-with-shared-access-token

# OCI Object Storage configuration
FB_INSTA_BUCKET=your-bucket-name
# FB_INSTA_PREFIX=quotes/png
# FB_INSTA_JPEG_PREFIX=converted
OCI_NAMESPACE=your-oci-namespace
OCI_REGION=your-oci-region
# OCI_PROFILE=DEFAULT

# Claude captioning
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
FB_INSTA_ENABLE_CAPTIONING=true
# Set FB_INSTA_ENABLE_CAPTIONING=false to post without captions (ANTHROPIC_API_KEY can then be left blank)
# FB_INSTA_CLAUDE_MODEL=claude-sonnet-4-5-20250929
# FB_INSTA_CLAUDE_MAX_TOKENS=120
# FB_INSTA_CAPTION_FALLBACK=Sharing today's inspiration ✨

# Telegram notifications (optional)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional tuning
# FB_INSTA_MEDIA_WAIT_SECONDS=30
# FB_INSTA_STATUS_POLL_SECONDS=5
# FB_INSTA_PRESIGN_EXPIRATION_SECONDS=900
